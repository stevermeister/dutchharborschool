---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = 'Частые вопросы о курсах нидерландского | Dutch Harbor School';
const description = 'Ответы на типичные вопросы: формат занятий, длительность, оплата, возврат денег, домашние задания, материалы курса нидерландского онлайн.';

const faqs = [
  { q: 'Как проходит обучение?', a: 'В маленьких группах (до 8 человек) в Google Meet — онлайн видеосвязь с преподавателем в реальном времени.' },
  { q: 'Сколько длится занятие?', a: 'Длительность занятия — 60 минут, 2 раза в неделю.' },
  { q: 'Как оплачивать?', a: '1 раз в месяц переводом на счёт до начала 1-го занятия. Стоимость — 65 евро за 8 занятий (месяц).' },
  { q: 'Что за материалы и где они?', a: 'У вас будет доступ к учебной онлайн-платформе, где хранятся все материалы классных и домашних занятий. Всё в одном месте.' },
  { q: 'Есть ли домашние задания?', a: 'Да. Потому что нас интересует именно ваш результат, а домашняя работа очень помогает закреплению материала и долгосрочному запоминанию.' },
  { q: 'Можно ли вернуть деньги?', a: 'Да. Если после первого урока вы не будете полностью довольны и сочтёте, что курс не соответствует вашим ожиданиям, вам гарантирован полный возврат оплаты.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<BaseLayout title={title} description={description} lang="ru" schema={faqSchema}>
  <section>
    <div class="container container--narrow">
      <h1>Ответы на типичные вопросы</h1>

      <div class="faq-list">
        {faqs.map(faq => (
          <details class="faq-item">
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>

      <div class="cta-block">
        <p>Не нашли ответ?</p>
        <a href="https://t.me/Language_guru" class="btn btn--primary" target="_blank" rel="noopener">Напишите в Telegram</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  h1 { text-align: center; margin-bottom: 2rem; }
  .faq-list { display: flex; flex-direction: column; gap: 0.75rem; }
  .faq-item { background: var(--color-bg-soft); border-radius: var(--radius-md); padding: 1.25rem 1.5rem; border-left: 4px solid var(--color-primary); }
  .faq-item summary { font-weight: 600; cursor: pointer; font-size: 1.0625rem; color: var(--color-primary); list-style-position: outside; }
  .faq-item summary:hover { color: var(--color-primary-dark); }
  .faq-item[open] summary { margin-bottom: 0.75rem; }
  .faq-item p { margin: 0; color: var(--color-text); line-height: 1.6; }
  .cta-block { text-align: center; margin-top: 3rem; }
  .cta-block p { color: var(--color-text-muted); margin-bottom: 1rem; }
</style>
