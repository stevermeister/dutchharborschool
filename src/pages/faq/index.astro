---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Часті питання про курси нідерландської | Dutch Harbor School';
const description = 'Відповіді на типові питання: формат занять, тривалість, оплата, повернення коштів, домашні завдання, матеріали курсу нідерландської мови онлайн.';

const faqs = [
  {
    q: 'Як проходить навчання?',
    a: 'У маленьких групах (до 8 людей) в Google Meet — онлайн відеозв\'язок з викладачем у реальному часі.',
  },
  {
    q: 'Скільки триває заняття?',
    a: 'Тривалість заняття — 60 хвилин, 2 рази на тиждень.',
  },
  {
    q: 'Як сплачувати?',
    a: '1 раз на місяць переказом на рахунок до початку 1-го заняття. Вартість — 65 євро за 8 занять (місяць).',
  },
  {
    q: 'Що за матеріали та де вони?',
    a: 'У вас буде доступ до навчальної онлайн-платформи, де зберігаються усі матеріали класних та домашніх занять. Все в одному місці.',
  },
  {
    q: 'Чи є домашні завдання?',
    a: 'Так. Тому що нас цікавить саме ваш результат, а домашня робота дуже допомагає закріпленню матеріалу та довготривалому запам\'ятовуванню.',
  },
  {
    q: 'Чи можна повернути гроші?',
    a: 'Так. Якщо після першого уроку ви не будете повністю задоволені і вважатимете, що курс не відповідає вашим очікуванням, вам гарантовано повне повернення оплати.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};
---
<BaseLayout title={title} description={description} lang="uk" schema={faqSchema}>
  <section>
    <div class="container container--narrow">
      <h1>Відповіді на типові питання</h1>

      <div class="faq-list">
        {faqs.map(faq => (
          <details class="faq-item">
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>

      <div class="cta-block">
        <p>Не знайшли відповідь?</p>
        <a href="https://t.me/Language_guru" class="btn btn--primary" target="_blank" rel="noopener">Напишіть у Telegram</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  h1 { text-align: center; margin-bottom: 2rem; }
  .faq-list { display: flex; flex-direction: column; gap: 0.75rem; }
  .faq-item {
    background: var(--color-bg-soft);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    border-left: 4px solid var(--color-primary);
  }
  .faq-item summary {
    font-weight: 600;
    cursor: pointer;
    font-size: 1.0625rem;
    color: var(--color-primary);
    list-style-position: outside;
  }
  .faq-item summary:hover { color: var(--color-primary-dark); }
  .faq-item[open] summary { margin-bottom: 0.75rem; }
  .faq-item p { margin: 0; color: var(--color-text); line-height: 1.6; }
  .cta-block { text-align: center; margin-top: 3rem; }
  .cta-block p { color: var(--color-text-muted); margin-bottom: 1rem; }
</style>
