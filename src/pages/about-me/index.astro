---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Про викладача — Maryna Suvorova | Dutch Harbor School';
const description = 'Maryna Suvorova — викладач нідерландської з понад 12 років досвіду. Педагогічна освіта Харківського університету ім. Каразіна, авторська методика, 4 мови.';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Maryna Suvorova',
  jobTitle: 'Викладач нідерландської мови',
  image: 'https://dutchharborschool.nl/images/maryna/maryna-1.jpg',
  worksFor: {
    '@type': 'EducationalOrganization',
    name: 'Dutch Harbor School',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Харківський національний університет імені В. Н. Каразіна',
  },
  knowsLanguage: ['uk', 'ru', 'nl', 'en'],
};
---
<BaseLayout title={title} description={description} lang="uk" ogImage="/images/maryna/maryna-1.jpg" schema={personSchema}>
  <section>
    <div class="container">
      <div class="about-grid">
        <div class="about-photos">
          <img src="/images/maryna/maryna-1.jpg" alt="Maryna Suvorova — викладач нідерландської" class="photo-main" width="300" height="300" />
          <img src="/images/maryna/maryna-3.jpg" alt="Марина на уроці" class="photo-small" width="300" height="300" loading="lazy" />
          <img src="/images/maryna/maryna-4.jpg" alt="Марина у вільний час" class="photo-small" width="300" height="300" loading="lazy" />
        </div>
        <div class="about-text">
          <h1>Про мене</h1>
          <p class="greeting">Привіт, давайте знайомитися!</p>
          <p>
            Мене звуть <strong>Марина Суворова</strong>, і я засновниця Dutch Harbor School.
          </p>
          <ul class="bio">
            <li>🎓 Маю педагогічну освіту <strong>Харківського національного університету імені В. Н. Каразіна</strong>, факультет іноземних мов</li>
            <li>📚 Понад <strong>12 років досвіду</strong> викладання іноземних мов</li>
            <li>✨ Дотримуюся <strong>авторської методики</strong>, яка об'єднує комунікативний та граматичний підходи</li>
            <li>🏆 Моїм найбільшим досягненням є знання та успіхи моїх студентів</li>
            <li>🌍 Володію <strong>4-ма мовами</strong> окрім 2-х рідних</li>
            <li>✈️ Люблю подорожувати далекими країнами та вивчати культури світу</li>
          </ul>
          <p class="mission">
            Мрію закохати людей у вивчення іноземних мов, тому що за роки моєї викладацької практики я бачила, наскільки знання мови може <strong>трансформувати життя</strong> та відкривати нові можливості.
          </p>
          <div class="cta-block">
            <a href="https://forms.gle/your-form-id" class="btn btn--primary btn--lg" target="_blank" rel="noopener">Записатися на пробний урок</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 3rem;
    align-items: start;
  }
  .about-photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    position: sticky;
    top: 100px;
  }
  .photo-main {
    grid-column: 1 / -1;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }
  .photo-small {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }
  .greeting {
    font-size: 1.25rem;
    color: var(--color-accent-dark);
    font-weight: 600;
    margin-top: 0.5rem;
  }
  .bio {
    list-style: none;
    padding: 0;
    margin: 2rem 0;
  }
  .bio li {
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--color-border);
    font-size: 1.0625rem;
  }
  .bio li:last-child { border-bottom: none; }
  .mission {
    background: var(--color-bg-soft);
    padding: 1.5rem;
    border-radius: var(--radius-md);
    border-left: 4px solid var(--color-accent);
    font-size: 1.0625rem;
    margin: 2rem 0;
  }
  .cta-block { margin-top: 2.5rem; }
  @media (max-width: 800px) {
    .about-grid { grid-template-columns: 1fr; gap: 2rem; }
    .about-photos { position: static; max-width: 380px; margin: 0 auto; }
  }
</style>
