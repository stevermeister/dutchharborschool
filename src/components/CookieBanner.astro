---
export interface Props {
  lang: 'uk' | 'ru';
}
const { lang } = Astro.props;

const t = lang === 'uk' ? {
  title: 'Ми використовуємо cookies',
  description: 'Цей сайт використовує cookies для аналітики (Google Analytics та Microsoft Clarity для запису сесій) — щоб ми могли покращувати курси та матеріали. Ваші дані анонімізовані.',
  accept: 'Прийняти всі',
  reject: 'Тільки необхідні',
  policy: 'Дізнатися більше',
  policyUrl: '/privacy-policy/',
} : {
  title: 'Мы используем cookies',
  description: 'Этот сайт использует cookies для аналитики (Google Analytics и Microsoft Clarity для записи сессий) — чтобы мы могли улучшать курсы и материалы. Ваши данные обезличены.',
  accept: 'Принять все',
  reject: 'Только необходимые',
  policy: 'Узнать больше',
  policyUrl: '/ru/privacy-policy/',
};
---
<div id="cookie-banner" class="cookie-banner" hidden aria-live="polite" aria-label="Cookie consent">
  <div class="cookie-banner__inner">
    <div class="cookie-banner__text">
      <strong>{t.title}</strong>
      <p>{t.description} <a href={t.policyUrl}>{t.policy}</a></p>
    </div>
    <div class="cookie-banner__actions">
      <button type="button" id="cookie-reject" class="btn btn--ghost">{t.reject}</button>
      <button type="button" id="cookie-accept" class="btn btn--primary">{t.accept}</button>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    var run = function() {
      var STORAGE_KEY = 'dhs_consent';
      var banner = document.getElementById('cookie-banner');
      if (!banner) return;

      try {
        var saved = localStorage.getItem(STORAGE_KEY);
        if (saved) {
          var parsed = JSON.parse(saved);
          var now = Date.now();
          if (parsed.timestamp && (now - parsed.timestamp) < 365 * 24 * 60 * 60 * 1000) {
            return;
          }
        }
      } catch (e) { /* ignore */ }

      banner.hidden = false;

      function saveConsent(granted) {
        var flags = granted ? {
          ad_storage: 'granted',
          ad_user_data: 'granted',
          ad_personalization: 'granted',
          analytics_storage: 'granted',
        } : {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
        };

        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify({
            flags: flags,
            timestamp: Date.now(),
            version: 1,
          }));
        } catch (e) { /* ignore */ }

        if (typeof gtag === 'function') {
          gtag('consent', 'update', flags);
        }

        if (typeof clarity === 'function') {
          clarity('consent', granted);
        }

        banner.classList.add('cookie-banner--hiding');
        setTimeout(function() { banner.hidden = true; }, 300);
      }

      document.getElementById('cookie-accept').addEventListener('click', function() {
        saveConsent(true);
      });
      document.getElementById('cookie-reject').addEventListener('click', function() {
        saveConsent(false);
      });
    };

    if ('requestIdleCallback' in window) {
      requestIdleCallback(run, { timeout: 2000 });
    } else {
      setTimeout(run, 100);
    }
  })();
</script>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    z-index: 1000;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: 0 -4px 20px rgba(15, 23, 42, 0.12), 0 8px 24px rgba(15, 23, 42, 0.08);
    max-width: 720px;
    margin: 0 auto;
    animation: slideUp 0.4s ease-out;
  }
  .cookie-banner__inner {
    padding: 1.25rem 1.5rem;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.5rem;
    align-items: center;
  }
  .cookie-banner__text strong {
    display: block;
    font-size: 0.9375rem;
    margin-bottom: 0.25rem;
    color: var(--color-text);
  }
  .cookie-banner__text p {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-text-soft);
    line-height: 1.5;
  }
  .cookie-banner__text a {
    color: var(--color-primary);
    text-decoration: underline;
    white-space: nowrap;
  }
  .cookie-banner__actions {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-shrink: 0;
  }
  .cookie-banner .btn {
    padding: 0.625rem 1.125rem;
    font-size: 0.875rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    border: none;
    font-weight: 600;
    white-space: nowrap;
  }
  .cookie-banner .btn--primary {
    background: var(--color-primary);
    color: white;
  }
  .cookie-banner .btn--primary:hover {
    background: var(--color-primary-dark);
  }
  .cookie-banner .btn--ghost {
    background: transparent;
    color: var(--color-text-soft);
    border: 1px solid var(--color-border);
  }
  .cookie-banner .btn--ghost:hover {
    background: var(--color-bg-muted);
    color: var(--color-text);
  }
  .cookie-banner--hiding {
    animation: slideDown 0.3s ease-in forwards;
  }
  @keyframes slideUp {
    from { transform: translateY(120%); opacity: 0; }
    to   { transform: translateY(0); opacity: 1; }
  }
  @keyframes slideDown {
    from { transform: translateY(0); opacity: 1; }
    to   { transform: translateY(120%); opacity: 0; }
  }
  @media (max-width: 640px) {
    .cookie-banner {
      bottom: 0.5rem;
      left: 0.5rem;
      right: 0.5rem;
    }
    .cookie-banner__inner {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 1rem 1.25rem;
    }
    .cookie-banner__actions {
      justify-content: stretch;
    }
    .cookie-banner .btn {
      flex: 1;
    }
  }
</style>
