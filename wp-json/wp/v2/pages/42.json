{"id":42,"date":"2023-12-14T13:21:07","date_gmt":"2023-12-14T13:21:07","guid":{"rendered":"https:\/\/dutchharborschool.nl\/?page_id=42"},"modified":"2023-12-15T16:59:35","modified_gmt":"2023-12-15T16:59:35","slug":"about-me","status":"publish","type":"page","link":"https:\/\/dutchharborschool.nl\/about-me\/","title":{"rendered":"\u041f\u0440\u043e \u043c\u0435\u043d\u0435"},"content":{"rendered":"\n<p>\u041f\u0440\u0438\u0432\u0456\u0442, \u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u0437\u043d\u0430\u0439\u043e\u043c\u0438\u0442\u0438\u0441\u044f!<\/p>\n\n\n\n<figure class=\"wp-block-image alignleft size-large is-resized\"><img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"585\" src=\"https:\/\/dutchharborschool.nl\/wp-content\/uploads\/2023\/12\/site-lady-1024x585.png\" alt=\"\" class=\"wp-image-17\" style=\"width:516px;height:auto\" srcset=\"https:\/\/dutchharborschool.nl\/wp-content\/uploads\/2023\/12\/site-lady-1024x585.png 1024w, https:\/\/dutchharborschool.nl\/wp-content\/uploads\/2023\/12\/site-lady-300x171.png 300w, https:\/\/dutchharborschool.nl\/wp-content\/uploads\/2023\/12\/site-lady-768x439.png 768w, https:\/\/dutchharborschool.nl\/wp-content\/uploads\/2023\/12\/site-lady-1536x878.png 1536w, https:\/\/dutchharborschool.nl\/wp-content\/uploads\/2023\/12\/site-lady.png 1792w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" \/><\/figure>\n\n\n\n<p>\u041c\u0435\u043d\u0435 \u0437\u0432\u0443\u0442\u044c \u041c\u0430\u0440\u0438\u043d\u0430 \u0421\u0443\u0432\u043e\u0440\u043e\u0432\u0430, \u0456 \u044f \u0437\u0430\u0441\u043d\u043e\u0432\u043d\u0438\u0446\u044f Dutch Harbor School. <\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>\u0412 \u043c\u0435\u043d\u0435 \u0454 \u043f\u0435\u0434\u0430\u0433\u043e\u0433\u0456\u0447\u043d\u0430 \u043e\u0441\u0432\u0456\u0442\u0430 \u0425\u0430\u0440\u043a\u0456\u0432\u0441\u044c\u043a\u043e\u0433\u043e \u043d\u0430\u0446\u0456\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0443\u043d\u0456\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430 \u0456\u043c. \u041a\u0430\u0440\u0430\u0437\u0456\u043d\u0430, \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442 \u0456\u043d\u043e\u0437\u0435\u043c\u043d\u0438\u0445 \u043c\u043e\u0432<\/li>\n\n\n\n<li>\u041c\u0430\u044e \u043f\u043e\u043d\u0430\u0434 12 \u0440\u043e\u043a\u0456\u0432 \u0434\u043e\u0441\u0432\u0456\u0434\u0443 \u0432\u0438\u043a\u043b\u0430\u0434\u0430\u043d\u043d\u044f<\/li>\n\n\n\n<li>\u0414\u043e\u0442\u0440\u0438\u043c\u0443\u044e\u0441\u044f \u0432\u043b\u0430\u0441\u043d\u043e\u0457 \u043c\u0435\u0442\u043e\u0434\u0438\u043a\u0438, \u044f\u043a\u0430 \u043e\u0431&#8217;\u0454\u0434\u043d\u0443\u0454 \u043a\u043e\u043c\u0443\u043d\u0456\u043a\u0430\u0442\u0438\u0432\u043d\u0438\u0439 \u0442\u0430 \u0433\u0440\u0430\u043c\u0430\u0442\u0438\u0447\u043d\u0438\u0439 \u043f\u0456\u0434\u0445\u043e\u0434\u0438<\/li>\n\n\n\n<li>\u041c\u043e\u0457\u043c \u043d\u0430\u0439\u0431\u0456\u043b\u044c\u0448\u0438\u043c \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f\u043c \u0454 \u0437\u043d\u0430\u043d\u043d\u044f \u0442\u0430 \u0443\u0441\u043f\u0456\u0445\u0438 \u043c\u043e\u0457\u0445 \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u0456\u0432<\/li>\n\n\n\n<li>\u0412\u043e\u043b\u043e\u0434\u0456\u044e 4-\u043c\u0430 \u043c\u043e\u0432\u0430\u043c\u0438 \u043e\u043a\u0440\u0456\u043c 2-\u0445 \u0440\u0456\u0434\u043d\u0438\u0445<\/li>\n\n\n\n<li>\u041b\u044e\u0431\u043b\u044e \u043f\u043e\u0434\u043e\u0440\u043e\u0436\u0443\u0432\u0430\u0442\u0438 \u0434\u0430\u043b\u0435\u043a\u0438\u043c\u0438 \u043a\u0440\u0430\u0457\u043d\u0430\u043c\u0438 \u0442\u0430 \u0432\u0438\u0432\u0447\u0430\u0442\u0438 \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u0438 \u0441\u0432\u0456\u0442\u0443<\/li>\n\n\n\n<li>\u041c\u0440\u0456\u044e \u0437\u0430\u043a\u043e\u0445\u0430\u0442\u0438 \u043b\u044e\u0434\u0435\u0439 \u0443 \u0432\u0438\u0432\u0447\u0435\u043d\u043d\u044f \u0456\u043d\u043e\u0437\u0435\u043c\u043d\u0438\u0445 \u043c\u043e\u0432, \u0442\u043e\u043c\u0443 \u0449\u043e \u0437\u0430 \u0440\u043e\u043a\u0438 \u043c\u043e\u0454\u0457 \u0432\u0438\u043a\u043b\u0430\u0434\u0430\u0446\u044c\u043a\u043e\u0457 \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0438 \u044f \u0431\u0430\u0447\u0438\u043b\u0430, \u043d\u0430\u0441\u043a\u0456\u043b\u044c\u043a\u0438 \u0437\u043d\u0430\u043d\u043d\u044f \u043c\u043e\u0432\u0438 \u043c\u043e\u0436\u0435 \u0442\u0440\u0430\u043d\u0441\u0444\u043e\u0440\u043c\u0443\u0432\u0430\u0442\u0438 \u0436\u0438\u0442\u0442\u044f \u0442\u0430 \u0432\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u0442\u0438 \u043d\u043e\u0432\u0456 \u043c\u043e\u0436\u043b\u0438\u0432\u043e\u0441\u0442\u0456<\/li>\n<\/ul>\n","protected":false},"excerpt":{"rendered":"<p>\u041f\u0440\u0438\u0432\u0456\u0442, \u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u0437\u043d\u0430\u0439\u043e\u043c\u0438\u0442\u0438\u0441\u044f! \u041c\u0435\u043d\u0435 \u0437\u0432\u0443\u0442\u044c \u041c\u0430\u0440\u0438\u043d\u0430 \u0421\u0443\u0432\u043e\u0440\u043e\u0432\u0430, \u0456 \u044f \u0437\u0430\u0441\u043d\u043e\u0432\u043d\u0438\u0446\u044f Dutch Harbor School.<\/p>\n","protected":false},"author":2,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"footnotes":""},"class_list":["post-42","page","type-page","status-publish","hentry"],"_links":{"self":[{"href":"https:\/\/dutchharborschool.nl\/wp-json\/wp\/v2\/pages\/42","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/dutchharborschool.nl\/wp-json\/wp\/v2\/pages"}],"about":[{"href":"https:\/\/dutchharborschool.nl\/wp-json\/wp\/v2\/types\/page"}],"author":[{"embeddable":true,"href":"https:\/\/dutchharborschool.nl\/wp-json\/wp\/v2\/users\/2"}],"replies":[{"embeddable":true,"href":"https:\/\/dutchharborschool.nl\/wp-json\/wp\/v2\/comments?post=42"}],"version-history":[{"count":4,"href":"https:\/\/dutchharborschool.nl\/wp-json\/wp\/v2\/pages\/42\