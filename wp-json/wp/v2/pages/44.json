{"id":44,"date":"2023-12-14T13:36:00","date_gmt":"2023-12-14T13:36:00","guid":{"rendered":"https:\/\/dutchharborschool.nl\/?page_id=44"},"modified":"2023-12-14T13:49:08","modified_gmt":"2023-12-14T13:49:08","slug":"how-it-happens","status":"publish","type":"page","link":"https:\/\/dutchharborschool.nl\/how-it-happens\/","title":{"rendered":"\u042f\u043a \u0446\u0435 \u0432\u0456\u0434\u0431\u0443\u0432\u0430\u0454\u0442\u044c\u0441\u044f:"},"content":{"rendered":"\n<p>\u041d\u0430\u0432\u0447\u0430\u043d\u043d\u044f \u043d\u0456\u0434\u0435\u0440\u043b\u0430\u043d\u0434\u0441\u044c\u043a\u043e\u0457 \u0432\u0456\u0434\u0431\u0443\u0432\u0430\u0454\u0442\u044c\u0441\u044f \u043e\u043d\u043b\u0430\u0439\u043d \u043f\u043e \u0432\u0456\u0434\u0435\u043e\u0437\u0432\u2019\u044f\u0437\u043a\u0443 (google meet) \u0443 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0445 \u0433\u0440\u0443\u043f\u0430\u0445&nbsp; \u0437 \u0432\u0438\u043a\u043b\u0430\u0434\u0430\u0447\u0435\u043c. \u0422\u0430\u043a\u0438\u043c \u0447\u0438\u043d\u043e\u043c \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0437\u0430\u0439\u043c\u0430\u0442\u0438\u0441\u044f \u0443 \u0431\u0443\u0434\u044c-\u044f\u043a\u043e\u043c\u0443 \u043c\u0456\u0441\u0446\u0456 \u0442\u0430 \u0437 \u0431\u0443\u0434\u044c-\u044f\u043a\u043e\u0433\u043e \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u044e: \u0437 \u043a\u043e\u043c\u043f\u2019\u044e\u0442\u0435\u0440\u0430 \u0430\u0431\u043e \u0437\u0456 \u0441\u043c\u0430\u0440\u0442\u0444\u043e\u043d\u0443.<\/p>\n\n\n\n<p>\u041e\u043a\u0440\u0456\u043c \u0437\u0430\u043d\u044f\u0442\u044c \u0437 \u0432\u0438\u043a\u043b\u0430\u0434\u0430\u0447\u0435\u043c, \u0443 \u0432\u0430\u0440\u0442\u0456\u0441\u0442\u044c \u0442\u0430\u043a\u043e\u0436 \u0432\u0445\u043e\u0434\u0438\u0442\u044c <strong>\u0434\u043e\u0441\u0442\u0443\u043f \u0434\u043e \u043d\u0430\u0432\u0447\u0430\u043b\u044c\u043d\u043e\u0457 \u043e\u043d\u043b\u0430\u0439\u043d\u2011\u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0438<\/strong> \u0437 \u0443\u0441\u0456\u043c\u0430 \u043c\u0430\u0442\u0435\u0440\u0456\u0430\u043b\u0430\u043c.<\/p>\n\n\n\n<p>C\u043f\u0456\u043b\u043a\u0443\u0432\u0430\u043d\u043d\u044f \u0441\u0442\u043e\u0441\u043e\u0432\u043d\u043e \u043d\u0430\u0448\u0438\u0445 \u0437\u0430\u043d\u044f\u0442\u044c \u0431\u0443\u0434\u0435 \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u0442\u0438 \u0443 \u0442\u0435\u043b\u0435\u0433\u0440\u0430\u043c-\u0433\u0440\u0443\u043f\u0456, \u0434\u0435 \u0431\u0443\u0434\u0435 \u043d\u0430\u0434\u0430\u043d\u0430 \u0432\u0441\u044f \u043d\u0435\u043e\u0431\u0445\u0456\u0434\u043d\u0430 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044f. \u0426\u0435 \u0431\u0443\u0434\u0435 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u043a\u0430\u043d\u0430\u043b\u043e\u043c \u0434\u043b\u044f \u0441\u043f\u0456\u043b\u043a\u0443\u0432\u0430\u043d\u043d\u044f \u0456 \u0432\u0430\u0436\u043b\u0438\u0432\u0438\u0445 \u043e\u043d\u043e\u0432\u043b\u0435\u043d\u044c.<\/p>\n\n\n\n<p><strong>\u0422\u0430\u043a\u0438\u043c \u0447\u0438\u043d\u043e\u043c \u0442\u0438 \u043e\u0442\u0440\u0438\u043c\u0430\u0454\u0448 \u0432 Dutch Harbor School:<\/strong><\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>\u0417\u0440\u0443\u0447\u043d\u0438\u0439 \u043e\u043d\u043b\u0430\u0439\u043d \u0444\u043e\u0440\u043c\u0430\u0442 \u0437\u0430\u043d\u044f\u0442\u044c.<\/li>\n\n\n\n<li>\u041c\u0430\u043b\u0435\u043d\u044c\u043a\u0456 \u0433\u0440\u0443\u043f\u0438 &#8211; \u0434\u043e 8 \u043b\u044e\u0434\u0435\u0439 \u0432 \u0433\u0440\u0443\u043f\u0456<\/li>\n\n\n\n<li>\u0421\u0443\u0447\u0430\u0441\u043d\u0456 \u043c\u0435\u0442\u043e\u0434\u0438\u043a\u0438, \u0449\u043e \u0441\u043f\u0440\u0438\u044f\u044e\u0442\u044c \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u043c\u0443 \u0432\u0438\u0432\u0447\u0435\u043d\u043d\u044e.<\/li>\n\n\n\n<li>\u041f\u043e\u0454\u0434\u043d\u0430\u043d\u043d\u044f \u0440\u0456\u0437\u043d\u0438\u0445 \u043f\u0456\u0434\u0445\u043e\u0434\u0456\u0432, \u044f\u043a\u0435 \u0440\u043e\u0431\u0438\u0442\u044c \u043d\u0430\u0432\u0447\u0430\u043d\u043d\u044f \u0446\u0456\u043a\u0430\u0432\u0438\u043c \u0442\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u0438\u043c.<\/li>\n<\/ul>\n","protected":false},"excerpt":{"rendered":"<p>\u041d\u0430\u0432\u0447\u0430\u043d\u043d\u044f \u043d\u0456\u0434\u0435\u0440\u043b\u0430\u043d\u0434\u0441\u044c\u043a\u043e\u0457 \u0432\u0456\u0434\u0431\u0443\u0432\u0430\u0454\u0442\u044c\u0441\u044f \u043e\u043d\u043b\u0430\u0439\u043d \u043f\u043e \u0432\u0456\u0434\u0435\u043e\u0437\u0432\u2019\u044f\u0437\u043a\u0443 (google meet) \u0443 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0445 \u0433\u0440\u0443\u043f\u0430\u0445&nbsp; \u0437 \u0432\u0438\u043a\u043b\u0430\u0434\u0430\u0447\u0435\u043c. \u0422\u0430\u043a\u0438\u043c \u0447\u0438\u043d\u043e\u043c \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0437\u0430\u0439\u043c\u0430\u0442\u0438\u0441\u044f \u0443 \u0431\u0443\u0434\u044c-\u044f\u043a\u043e\u043c\u0443 \u043c\u0456\u0441\u0446\u0456 \u0442\u0430 \u0437 \u0431\u0443\u0434\u044c-\u044f\u043a\u043e\u0433\u043e \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u044e: \u0437 \u043a\u043e\u043c\u043f\u2019\u044e\u0442\u0435\u0440\u0430 \u0430\u0431\u043e \u0437\u0456 \u0441\u043c\u0430\u0440\u0442\u0444\u043e\u043d\u0443. \u041e\u043a\u0440\u0456\u043c \u0437\u0430\u043d\u044f\u0442\u044c \u0437 \u0432\u0438\u043a\u043b\u0430\u0434\u0430\u0447\u0435\u043c, \u0443 \u0432\u0430\u0440\u0442\u0456\u0441\u0442\u044c \u0442\u0430\u043a\u043e\u0436 \u0432\u0445\u043e\u0434\u0438\u0442\u044c \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u043e \u043d\u0430\u0432\u0447\u0430\u043b\u044c\u043d\u043e\u0457 \u043e\u043d\u043b\u0430\u0439\u043d\u2011\u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0438 \u0437 \u0443\u0441\u0456\u043c\u0430 \u043c\u0430\u0442\u0435\u0440\u0456\u0430\u043b\u0430\u043c. C\u043f