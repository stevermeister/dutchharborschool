8\u0432\u043d\u0438\u0445 \u0436\u0438\u0432\u0438\u0445 \u0437\u0430\u043d\u044f\u0442\u0442\u044f\u0445 \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u0438 \u0437\u043c\u043e\u0436\u0443\u0442\u044c \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0443\u0432\u0430\u0442\u0438 \u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f, \u0441\u043b\u0443\u0445\u0430\u043d\u043d\u044f \u0442\u0430 \u0440\u043e\u0437\u0443\u043c\u0456\u043d\u043d\u044f \u043d\u0456\u0434\u0435\u0440\u043b\u0430\u043d\u0434\u0441\u044c\u043a\u043e\u0457 \u043c\u043e\u0432\u0438 \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c\u0443 \u0447\u0430\u0441\u0456, \u0441\u043f\u0440\u0438\u044f\u044e\u0447\u0438 \u0433\u043b\u0438\u0431\u0448\u043e\u043c\u0443 \u0437\u0430\u043d\u0443\u0440\u0435\u043d\u043d\u044e \u0443 \u043c\u043e\u0432\u0443.<\/p>\n\n\n\n<p>\u0427\u043e\u043c\u0443 \u0432\u0447\u0438\u0442\u0438\u0441\u044f \u0443 \u043d\u0430\u0441: <\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>\u0406\u043d\u0434\u0438\u0432\u0456\u0434\u0443\u0430\u043b\u044c\u043d\u0438\u0439 \u043f\u0456\u0434\u0445\u0456\u0434:<\/strong> \u041a\u043e\u0436\u0435\u043d \u0441\u0442\u0443\u0434\u0435\u043d\u0442 \u043e\u0442\u0440\u0438\u043c\u0443\u0454 \u0443\u0432\u0430\u0433\u0443 \u0432\u0456\u0434 \u043a\u0432\u0430\u043b\u0456\u0444\u0456\u043a\u043e\u0432\u0430\u043d\u0438\u0445 \u0432\u0438\u043a\u043b\u0430\u0434\u0430\u0447\u0456\u0432 \u0442\u0430 \u0432\u0437\u0430\u0454\u043c\u043e\u0434\u0456\u0454 \u0437 \u0456\u043d\u0448\u0438\u043c\u0438 \u0443\u0447\u043d\u044f\u043c\u0438 \u0443 \u0437\u0431\u0430\u043b\u0430\u043d\u0441\u043e\u0432\u0430\u043d\u043e\u043c\u0443 \u0442\u0430 \u0437\u0440\u0443\u0447\u043d\u043e\u043c\u0443 \u043f\u0440\u043e\u0446\u0435\u0441\u0456 \u043d\u0430\u0432\u0447\u0430\u043d\u043d\u044f. <\/li>\n\n\n\n<li><strong>\u0421\u0443\u0447\u0430\u0441\u043d\u0456 \u043c\u0435\u0442\u043e\u0434\u0438:<\/strong> \u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454\u043c\u043e \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0456 \u0442\u0430 \u0446\u0456\u043a\u0430\u0432\u0456 \u043c\u0435\u0442\u043e\u0434\u0438 \u0432\u0438\u0432\u0447\u0435\u043d\u043d\u044f \u0434\u043b\u044f \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0438\u0445 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0456\u0432.<\/li>\n\n\n\n<li><strong>\u0413\u043d\u0443\u0447\u043a\u0438\u0439 \u0440\u043e\u0437\u043a\u043b\u0430\u0434:<\/strong> \u0412\u0438\u0431\u0456\u0440 \u0434\u043d\u0456\u0432 \u0442\u0430 \u0433\u043e\u0434\u0438\u043d, \u044f\u043a\u0456 \u043f\u0456\u0434\u0445\u043e\u0434\u044f\u0442\u044c \u0441\u0430\u043c\u0435 \u0432\u0430\u043c.<\/li>\n<\/ul>\n\n\n\n<p>\u041f\u0440\u0438\u0454\u0434\u043d\u0443\u0439\u0442\u0435\u0441\u044f \u0434\u043e \u043d\u0430\u0448\u043e\u0457 \u0448\u043a\u043e\u043b\u0438, \u0434\u0435 \u0432\u0438\u0432\u0447\u0435\u043d\u043d\u044f \u043d\u0456\u0434\u0435\u0440\u043b\u0430\u043d\u0434\u0441\u044c\u043a\u043e\u0457 \u043c\u043e\u0432\u0438 \u0441\u0442\u0430\u0454 \u0437\u0430\u0445\u043e\u043f\u043b\u044e\u044e\u0447\u043e\u044e \u043f\u043e\u0434\u043e\u0440\u043e\u0436\u0436\u044e. \u041f\u043e\u043f\u043e\u043d\u0443\u044e \u0440\u0430\u0437\u043e\u043c \u0434\u043e\u043b\u0430\u0442\u0438 \u043c\u043e\u0432\u043d\u0456 \u0431\u0430\u0440&#8217;\u0454\u0440\u0438 \u0442\u0430 \u0432\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u0442\u0438 \u043d\u043e\u0432\u0456 \u043c\u043e\u0436\u043b\u0438\u0432\u043e\u0441\u0442\u0456!<\/p>\n\n\n\n<p><\/p>\n\n\n\n<p><\/p>\n","protected":false},"excerpt":{"rendered":"<p>\u0412\u0441\u0435 \u043f\u043e\u0447\u0430\u043b\u043e\u0441\u044f \u0432\u043e\u0441\u0435\u043d\u0438 2023, \u043a\u043e\u043b\u0438 \u044f \u0432\u0438\u0440\u0456\u0448\u043b\u0430 \u043f\u043e\u0454\u0434\u043d\u0430\u0442\u0438 \u0441\u0432\u0456\u0439 \u0434\u043e\u0441\u0432\u0456\u0434 \u0431\u043