{"id":3,"date":"2023-12-10T11:14:05","date_gmt":"2023-12-10T11:14:05","guid":{"rendered":"https:\/\/dutchharborschool.nl\/?page_id=3"},"modified":"2023-12-21T09:03:42","modified_gmt":"2023-12-21T09:03:42","slug":"privacy-policy","status":"publish","type":"page","link":"https:\/\/dutchharborschool.nl\/privacy-policy\/","title":{"rendered":"\u041f\u043e\u043b\u0456\u0442\u0438\u043a\u0430 \u043a\u043e\u043d\u0444\u0456\u0434\u0435\u043d\u0446\u0456\u0439\u043d\u043e\u0441\u0442\u0456"},"content":{"rendered":"\n<h2 class=\"wp-block-heading\">\u0425\u0442\u043e \u043c\u0438<\/h2>\n\n\n\n<p>\u041d\u0430\u0448\u0430 \u0430\u0434\u0440\u0435\u0441\u0430 \u0432\u0435\u0431-\u0441\u0430\u0439\u0442\u0443: <a href=\"https:\/\/dutchharborschool.nl\/\">https:\/\/dutchharborschool.nl<\/a>.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\">\u041a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456<\/h2>\n\n\n\n<p>\u041a\u043e\u043b\u0438 \u0432\u0456\u0434\u0432\u0456\u0434\u0443\u0432\u0430\u0447\u0456 \u0437\u0430\u043b\u0438\u0448\u0430\u044e\u0442\u044c \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456 \u043d\u0430 \u0441\u0430\u0439\u0442\u0456, \u043c\u0438 \u0437\u0431\u0438\u0440\u0430\u0454\u043c\u043e \u0434\u0430\u043d\u0456, \u0432\u043a\u0430\u0437\u0430\u043d\u0456 \u0443 \u0444\u043e\u0440\u043c\u0456 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u0432, \u0430 \u0442\u0430\u043a\u043e\u0436 IP-\u0430\u0434\u0440\u0435\u0441\u0443 \u0432\u0456\u0434\u0432\u0456\u0434\u0443\u0432\u0430\u0447\u0430 \u0442\u0430 \u0440\u044f\u0434\u043e\u043a \u0430\u0433\u0435\u043d\u0442\u0430 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430 \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0430, \u0449\u043e\u0431 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u0442\u0438 \u0443 \u0432\u0438\u044f\u0432\u043b\u0435\u043d\u043d\u0456 \u0441\u043f\u0430\u043c\u0443.<\/p>\n\n\n\n<p>\u0410\u043d\u043e\u043d\u0456\u043c\u0456\u0437\u043e\u0432\u0430\u043d\u0438\u0439 \u0440\u044f\u0434\u043e\u043a, \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u0438\u0439 \u0437 \u0432\u0430\u0448\u043e\u0457 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u0457 \u0430\u0434\u0440\u0435\u0441\u0438 (\u0442\u0430\u043a\u043e\u0436 \u0432\u0456\u0434\u043e\u043c\u0438\u0439 \u044f\u043a \u0445\u0435\u0448), \u043c\u043e\u0436\u0435 \u0431\u0443\u0442\u0438 \u043d\u0430\u0434\u0430\u043d\u0438\u0439 \u0441\u043b\u0443\u0436\u0431\u0456 Gravatar, \u0449\u043e\u0431 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438, \u0447\u0438 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454\u0442\u0435 \u0432\u0438 \u0457\u0457. \u041f\u043e\u043b\u0456\u0442\u0438\u043a\u0430 \u043a\u043e\u043d\u0444\u0456\u0434\u0435\u043d\u0446\u0456\u0439\u043d\u043e\u0441\u0442\u0456 \u0441\u043b\u0443\u0436\u0431\u0438 Gravatar \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430 \u0442\u0443\u0442: <a href=\"https:\/\/automattic.com\/privacy\/\">https:\/\/automattic.com\/privacy\/<\/a>. \u041f\u0456\u0441\u043b\u044f \u0441\u0445\u0432\u0430\u043b\u0435\u043d\u043d\u044f \u0432\u0430\u0448\u043e\u0433\u043e \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u044f, \u0432\u0430\u0448\u0435 \u0444\u043e\u0442\u043e \u043f\u0440\u043e\u0444\u0456\u043b\u044e \u0431\u0443\u0434\u0435 \u0432\u0438\u0434\u0438\u043c\u0438\u043c \u0434\u043b\u044f \u0433\u0440\u043e\u043c\u0430\u0434\u0441\u044c\u043a\u043e\u0441\u0442\u0456 \u0443 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0456 \u0432\u0430\u0448\u043e\u0433\u043e \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u044f.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\">\u041c\u0435\u0434\u0456\u0430<\/h2>\n\n\n\n<p>\u042f\u043a\u0449\u043e \u0432\u0438 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454\u0442\u0435 \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f \u043d\u0430 \u0432\u0435\u0431-\u0441\u0430\u0439\u0442, \u0432\u0430\u043c \u0441\u043b\u0456\u0434 \u0443\u043d\u0438\u043a\u0430\u0442\u0438 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u044c \u0437 \u0432\u0431\u0443\u0434\u043e\u0432\u0430\u043d\u0438\u043c\u0438 \u0434\u0430\u043d\u0438\u043c\u0438 \u043c\u0456\u0441\u0446\u0435\u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0435\u043d\u043d\u044f (EXIF GPS). \u0412\u0456\u0434\u0432\u0456\u0434\u0443\u0432\u0430\u0447\u0456 \u0432\u0435\u0431-\u0441\u0430\u0439\u0442\u0443 \u043c\u043e\u0436\u0443\u0442\u044c \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0432\u0430\u0442\u0438 \u0442\u0430 \u0432\u0438\u043b\u0443\u0447\u0430\u0442\u0438 \u0431\u0443\u0434\u044c-\u044f\u043a\u0456 \u0434\u0430\u043d\u0456 \u043f\u0440\u043e \u043c\u0456\u0441\u0446\u0435\u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0435\u043d\u043d\u044f \u0437 \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u044c \u043d\u0430 \u0432\u0435\u0431-\u0441\u0430\u0439\u0442\u0456.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\">Cookies (\u0424\u0430\u0439\u043b\u0438 cookie)<\/h2>\n\n\n\n<p>\u042f\u043a\u0449\u043e \u0432\u0438 \u0437\u0430\u043b\u0438\u0448\u0430\u0454\u0442\u0435 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440 \u043d\u0430 \u043d\u0430\u0448\u043e\u043c\u0443 \u0441\u0430\u0439\u0442\u0456, \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u043f\u043e\u0433\u043e\u0434\u0438\u0442\u0438\u0441\u044f \u043d\u0430 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u043d\u043d\u044f \u0432\u0430\u0448\u043e\u0433\u043e \u0456\u043c\u0435\u043d\u0456, \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u0457 \u043f\u043e\u0448\u0442\u0438 \u0442\u0430 \u0432\u0435\u0431-\u0441\u0430\u0439\u0442\u0443 \u0443 \u0444\u0430\u0439\u043b\u0430\u0445 cookie. \u0426\u0435 \u0440\u043e\u0431\u0438\u0442\u044c\u0441\u044f \u0434\u043b\u044f \u0432\u0430\u0448\u043e\u0457 \u0437\u0440\u0443\u0447\u043d\u043e\u0441\u0442\u0456, \u0449\u043e\u0431 \u0432\u0430\u043c \u043d\u0435 \u0434\u043e\u0432\u0435\u043b\u043e\u0441\u044f \u0437\u043d\u043e\u0432\u0443 \u0432\u0432\u043e\u0434\u0438\u0442\u0438 \u0441\u0432\u043e\u0457 \u0434\u0430\u043d\u0456, \u043a\u043e\u043b\u0438 \u0432\u0438 \u0437\u0430\u043b\u0438\u0448\u0430\u0454\u0442\u0435 \u0456\u043d\u0448\u0438\u0439 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440. \u0426\u0456 \u0444\u0430\u0439\u043b\u0438 cookie \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0442\u0438\u043c\u0443\u0442\u044c\u0441\u044f \u043f\u0440\u043e\u0442\u044f\u0433\u043e\u043c \u043e\u0434\u043d\u043e\u0433\u043e \u0440\u043e\u043a\u0443.<\/p>\n\n\n\n<p>\u042f\u043a\u0449\u043e \u0432\u0438 \u0432\u0456\u0434\u0432\u0456\u0434\u0443\u0454\u0442\u0435 \u043d\u0430\u0448\u0443 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0443 \u0432\u0445\u043e\u0434\u0443, \u043c\u0438 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043c\u043e \u0442\u0438\u043c\u0447\u0430\u0441\u043e\u0432\u0438\u0439 \u0444\u0430\u0439\u043b cookie, \u0449\u043e\u0431 \u0432\u0438\u0437\u043d\u0430\u0447\u0438\u0442\u0438, \u0447\u0438 \u043f\u0440\u0438\u0439\u043c\u0430\u0454 \u0432\u0430\u0448 \u0431\u0440\u0430\u0443\u0437\u0435\u0440 \u0444\u0430\u0439\u043b\u0438 cookie. \u0426\u0435\u0439 \u0444\u0430\u0439\u043b cookie \u043d\u0435 \u043c\u0456\u0441\u0442\u0438\u0442\u044c \u043e\u0441\u043e\u0431\u0438\u0441\u0442\u0438\u0445 \u0434\u0430\u043d\u0438\u0445 \u0456 \u0432\u0438\u0434\u0430\u043b\u044f\u0454\u0442\u044c\u0441\u044f, \u043a\u043e\u043b\u0438 \u0432\u0438 \u0437\u0430\u043a\u0440\u0438\u0432\u0430\u0454\u0442\u0435 \u0431\u0440\u0430\u0443\u0437\u0435\u0440.<\/p>\n\n\n\n<p>\u041a\u043e\u043b\u0438 \u0432\u0438 \u0432\u0445\u043e\u0434\u0438\u0442\u0435 \u0432 \u0441\u0438\u0441\u0442\u0435\u043c\u0443, \u043c\u0438 \u0442\u0430\u043a\u043e\u0436 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u044e\u0454\u043c\u043e \u043a\u0456\u043b\u044c\u043a\u0430 \u0444\u0430\u0439\u043b\u0456\u0432 cookie \u0434\u043b\u044f \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f \u0432\u0430\u0448\u043e\u0457 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u0457 \u0434\u043b\u044f \u0432\u0445\u043e\u0434\u0443 \u0442\u0430 \u0432\u0430\u0448\u0438\u0445 \u0432\u0430\u0440\u0456\u0430\u043d\u0442\u0456\u0432 \u0432\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f \u0435\u043a\u0440\u0430\u043d\u0430. \u0424\u0430\u0439\u043b\u0438 cookie \u0434\u043b\u044f \u0432\u0445\u043e\u0434\u0443 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u044e\u0442\u044c\u0441\u044f \u043f\u0440\u043e\u0442\u044f\u0433\u043e\u043c \u0434\u0432\u043e\u0445 \u0434\u043d\u0456\u0432, \u0430 \u0444\u0430\u0439\u043b\u0438 cookie \u0434\u043b\u044f \u0432\u0430\u0440\u0456\u0430\u043d\u0442\u0456\u0432 \u0435\u043a\u0440\u0430\u043d\u0430 &#8211; \u043f\u0440\u043e\u0442\u044f\u0433\u043e\u043c \u0440\u043e\u043a\u0443. \u042f\u043a\u0449\u043e \u0432\u0438 \u0432\u0438\u0431\u0435\u0440\u0435\u0442\u0435 &#8220;\u0417\u0430\u043f\u0430\u043c&#8217;\u044f\u0442\u0430\u0442\u0438 \u043c\u0435\u043d\u0435&#8221;, \u0432\u0430\u0448 \u0432\u0445\u0456\u0434 \u0431\u0443\u0434\u0435 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0442\u0438\u0441\u044f \u043f\u0440\u043e\u0442\u044f\u0433\u043e\u043c \u0434\u0432\u043e\u0445 \u0442\u0438\u0436\u043d\u0456\u0432. \u042f\u043a\u0449\u043e \u0432\u0438 \u0432\u0438\u0439\u0434\u0435\u0442\u0435 \u0437\u0456 \u0441\u0432\u043e\u0433\u043e \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u043e\u0433\u043e \u0437\u0430\u043f\u0438\u0441\u0443, \u0444\u0430\u0439\u043b\u0438 cookie \u0434\u043b\u044f \u0432\u0445\u043e\u0434\u0443 \u0431\u0443\u0434\u0443\u0442\u044c \u0432\u0438\u0434\u0430\u043b\u0435\u043d\u0456.<\/p>\n\n\n\n<p>\u042f\u043a\u0449\u043e \u0432\u0438 \u0440\u0435\u0434\u0430\u0433\u0443\u0454\u0442\u0435 \u0430\u0431\u043e \u043f\u0443\u0431\u043b\u0456\u043a\u0443\u0454\u0442\u0435 \u0441\u0442\u0430\u0442\u0442\u044e, \u0443 \u0432\u0430\u0448\u043e\u043c\u0443 \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0456 \u0431\u0443\u0434\u0435 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043e \u0434\u043e\u0434\u0430\u0442\u043a\u043e\u0432\u0438\u0439 \u0444\u0430\u0439\u043b cookie. \u0426\u0435\u0439 \u0444\u0430\u0439\u043b cookie \u043d\u0435 \u043c\u0456\u0441\u0442\u0438\u0442\u044c \u043e\u0441\u043e\u0431\u0438\u0441\u0442\u0438\u0445 \u0434\u0430\u043d\u0438\u0445 \u0456 \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u043a\u0430\u0437\u0443\u0454 ID \u043f\u043e\u0441\u0442\u0430 \u0441\u0442\u0430\u0442\u0442\u0456, \u044f\u043a\u0443 \u0432\u0438 \u0449\u043e\u0439\u043d\u043e \u0432\u0456\u0434\u0440\u0435\u0434\u0430\u0433\u0443\u0432\u0430\u043b\u0438. \u0412\u0456\u043d \u0434\u0456\u0454 \u043f\u0440\u043e\u0442\u044f\u0433\u043e\u043c 1 \u0434\u043d\u044f.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\">\u0412\u0431\u0443\u0434\u043e\u0432\u0430\u043d\u0438\u0439 \u043a\u043e\u043d\u0442\u0435\u043d\u0442 \u0437 \u0456\u043d\u0448\u0438\u0445 \u0432\u0435\u0431-\u0441\u0430\u0439\u0442\u0456\u0432<\/h2>\n\n\n\n<p>\u0421\u0442\u0430\u0442\u0442\u0456 \u043d\u0430 \u0446\u044c\u043e\u043c\u0443 \u0441\u0430\u0439\u0442\u0456 \u043c\u043e\u0436\u0443\u0442\u044c \u0432\u043a\u043b\u044e\u0447\u0430\u0442\u0438 \u0432\u0431\u0443\u0434\u043e\u0432\u0430\u043d\u0438\u0439 \u043a\u043e\u043d\u0442\u0435\u043d\u0442 (\u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0432\u0456\u0434\u0435\u043e, \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f, \u0441\u0442\u0430\u0442\u0442\u0456 \u0442\u043e\u0449\u043e). \u0412\u0431\u0443\u0434\u043e\u0432\u0430\u043d\u0438\u0439 \u043a\u043e\u043d\u0442\u0435\u043d\u0442 \u0437 \u0456\u043d\u0448\u0438\u0445 \u0432\u0435\u0431-\u0441\u0430\u0439\u0442\u0456\u0432 \u043f\u043e\u0432\u043e\u0434\u0438\u0442\u044c\u0441\u044f \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e \u0442\u0430\u043a \u0441\u0430\u043c\u043e, \u044f\u043a \u0456 \u044f\u043a\u0431\u0438 \u0432\u0456\u0434\u0432\u0456\u0434\u0443\u0432\u0430\u0447 \u0432\u0456\u0434\u0432\u0456\u0434\u0430\u0432 \u0456\u043d\u0448\u0438\u0439 \u0432\u0435\u0431-\u0441\u0430\u0439\u0442.<\/p>\n\n\n\n<p>\u0426\u0456 \u0432\u0435\u0431-\u0441\u0430\u0439\u0442\u0438 \u043c\u043e\u0436\u0443\u0442\u044c \u0437\u0431\u0438\u0440\u0430\u0442\u0438 \u0434\u0430\u043d\u0456 \u043f\u0440\u043e \u0432\u0430\u0441, \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0444\u0430\u0439\u043b\u0438 cookie, \u0432\u0431\u0443\u0434\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0434\u043e\u0434\u0430\u0442\u043a\u043e\u0432\u0435 \u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0454 \u0432\u0456\u0434\u0441\u0442\u0435\u0436\u0435\u043d\u043d\u044f \u0442\u0430 \u043c\u043e\u043d\u0456\u0442\u043e\u0440\u0438\u0442\u0438 \u0432\u0430\u0448\u0443 \u0432\u0437\u0430\u0454\u043c\u043e\u0434\u0456\u044e \u0437 \u0432\u0431\u0443\u0434\u043e\u0432\u0430\u043d\u0438\u043c \u043a\u043e\u043d\u0442\u0435\u043d\u0442\u043e\u043c, \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0447\u0438 \u0432\u0456\u0434\u0441\u0442\u0435\u0436\u0435\u043d\u043d\u044f \u0432\u0430\u0448\u043e\u0457 \u0432\u0437\u0430\u0454\u043c\u043e\u0434\u0456\u0457 \u0437 \u0432\u0431\u0443\u0434\u043e\u0432\u0430\u043d\u0438\u043c \u043a\u043e\u043d\u0442\u0435\u043d\u0442\u043e\u043c, \u044f\u043a\u0449\u043e \u0443 \u0432\u0430\u0441 \u0454 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u0438\u0439 \u0437\u0430\u043f\u0438\u0441 \u0442\u0430 \u0432\u0438 \u0443\u0432\u0456\u0439\u0448\u043b\u0438 \u043d\u0430 \u0446\u0435\u0439 \u0432\u0435\u0431-\u0441\u0430\u0439\u0442.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\">\u0417 \u043a\u0438\u043c \u043c\u0438 \u0434\u0456\u043b\u0438\u043c\u043e\u0441\u044f \u0432\u0430\u0448\u0438\u043c\u0438 \u0434\u0430\u043d\u0438\u043c\u0438<\/h2>\n\n\n\n<p>\u042f\u043a\u0449\u043e \u0432\u0438 \u0437\u0430\u043f\u0438\u0442\u0443\u0454\u0442\u0435 \u0441\u043a\u0438\u0434\u0430\u043d\u043d\u044f \u043f\u0430\u0440\u043e\u043b\u044f, \u0432\u0430\u0448\u0430 IP-\u0430\u0434\u0440\u0435\u0441\u0430 \u0431\u0443\u0434\u0435 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0430 \u0432 \u043b\u0438\u0441\u0442 \u0437\u0456 \u0441\u043a\u0438\u0434\u0430\u043d\u043d\u044f\u043c.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\">\u042f\u043a \u0434\u043e\u0432\u0433\u043e \u043c\u0438 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0454\u043c\u043e \u0432\u0430\u0448\u0456 \u0434\u0430\u043d\u0456<\/h2>\n\n\n\n<p>\u042f\u043a\u0449\u043e \u0432\u0438 \u0437\u0430\u043b\u0438\u0448\u0430\u0454\u0442\u0435 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440, \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440 \u0442\u0430 \u0439\u043e\u0433\u043e \u043c\u0435\u0442\u0430\u0434\u0430\u043d\u0456 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u044e\u0442\u044c\u0441\u044f \u043d\u0435\u043e\u0431\u043c\u0435\u0436\u0435\u043d\u043e. \u0426\u0435 \u0440\u043e\u0431\u0438\u0442\u044c\u0441\u044f \u0434\u043b\u044f \u0442\u043e\u0433\u043e, \u0449\u043e\u0431 \u043c\u0438 \u043c\u043e\u0433\u043b\u0438 \u0432\u043f\u0456\u0437\u043d\u0430\u0442\u0438 \u0442\u0430 \u0441\u0445\u0432\u0430\u043b\u0438\u0442\u0438 \u0431\u0443\u0434\u044c-\u044f\u043a\u0456 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0456 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e, \u0430 \u043d\u0435 \u0443\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u0442\u0438 \u0457\u0445 \u0443 \u0447\u0435\u0440\u0437\u0456 \u043c\u043e\u0434\u0435\u0440\u0430\u0446\u0456\u0457.<\/p>\n\n\n\n<p>\u0414\u043b\u044f \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0456\u0432, \u044f\u043a\u0456 \u0440\u0435\u0454\u0441\u0442\u0440\u0443\u044e\u0442\u044c\u0441\u044f \u043d\u0430 \u043d\u0430\u0448\u043e\u043c\u0443 \u0432\u0435\u0431-\u0441\u0430\u0439\u0442\u0456 (\u044f\u043a\u0449\u043e \u0442\u0430\u043a\u0456 \u0454), \u043c\u0438 \u0442\u0430\u043a\u043e\u0436 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0454\u043c\u043e \u043e\u0441\u043e\u0431\u0438\u0441\u0442\u0443 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044e, \u044f\u043a\u0443 \u0432\u043e\u043d\u0438 \u043d\u0430\u0434\u0430\u044e\u0442\u044c \u0443 \u0441\u0432\u043e\u0454\u043c\u0443 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0446\u044c\u043a\u043e\u043c\u0443 \u043f\u0440\u043e\u0444\u0456\u043b\u0456. \u0423\u0441\u0456 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0456 \u043c\u043e\u0436\u0443\u0442\u044c \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u0434\u0430\u0442\u0438, \u0440\u0435\u0434\u0430\u0433\u0443\u0432\u0430\u0442\u0438 \u0430\u0431\u043e \u0432\u0438\u0434\u0430\u043b\u044f\u0442\u0438 \u0441\u0432\u043e\u044e \u043e\u0441\u043e\u0431\u0438\u0441\u0442\u0443 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044e \u0432 \u0431\u0443\u0434\u044c-\u044f\u043a\u0438\u0439 \u0447\u0430\u0441 (\u043a\u0440\u0456\u043c \u0442\u043e\u0433\u043e, \u0449\u043e \u0432\u043e\u043d\u0438 \u043d\u0435 \u043c\u043e\u0436\u0443\u0442\u044c \u0437\u043c\u0456\u043d\u0438\u0442\u0438 \u0441\u0432\u043e\u0454 \u0456\u043c&#8217;\u044f \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430). \u0410\u0434\u043c\u0456\u043d\u0456\u0441\u0442\u0440\u0430\u0442\u043e\u0440\u0438 \u0432\u0435\u0431-\u0441\u0430\u0439\u0442\u0443 \u0442\u0430\u043a\u043e\u0436 \u043c\u043e\u0436\u0443\u0442\u044c \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u0434\u0430\u0442\u0438 \u0442\u0430 \u0440\u0435\u0434\u0430\u0433\u0443\u0432\u0430\u0442\u0438 \u0446\u044e \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044e.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\">\u042f\u043a\u0456 \u0443 \u0432\u0430\u0441 \u043f\u0440\u0430\u0432\u0430 \u043d\u0430\u0434 \u0432\u0430\u0448\u0438\u043c\u0438 \u0434\u0430\u043d\u0438\u043c\u0438<\/h2>\n\n\n\n<p>\u042f\u043a\u0449\u043e \u0443 \u0432\u0430\u0441 \u0454 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u0438\u0439 \u0437\u0430\u043f\u0438\u0441 \u043d\u0430 \u0446\u044c\u043e\u043c\u0443 \u0441\u0430\u0439\u0442\u0456, \u0430\u0431\u043e \u0432\u0438 \u0437\u0430\u043b\u0438\u0448\u0430\u043b\u0438 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456, \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0437\u0430\u043f\u0440\u043e\u0441\u0438\u0442\u0438 \u043e\u0442\u0440\u0438\u043c\u0430\u0442\u0438 \u0435\u043a\u0441\u043f\u043e\u0440\u0442\u043e\u0432\u0430\u043d\u0438\u0439 \u0444\u0430\u0439\u043b \u043e\u0441\u043e\u0431\u0438\u0441\u0442\u0438\u0445 \u0434\u0430\u043d\u0438\u0445, \u044f\u043a\u0456 \u043c\u0438 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0454\u043c\u043e \u043f\u0440\u043e \u0432\u0430\u0441, \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0447\u0438 \u0431\u0443\u0434\u044c-\u044f\u043a\u0456 \u0434\u0430\u043d\u0456, \u044f\u043a\u0456 \u0432\u0438 \u043d\u0430\u043c \u043d\u0430\u0434\u0430\u043b\u0438. \u0412\u0438 \u0442\u0430\u043a\u043e\u0436 \u043c\u043e\u0436\u0435\u0442\u0435 \u0437\u0430\u043f\u0440\u043e\u0441\u0438\u0442\u0438, \u0449\u043e\u0431 \u043c\u0438 \u0441\u0442\u0435\u0440\u043b\u0438 \u0431\u0443\u0434\u044c-\u044f\u043a\u0456 \u043e\u0441\u043e\u0431\u0438\u0441\u0442\u0456 \u0434\u0430\u043d\u0456, \u044f\u043a\u0456 \u043c\u0438 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0454\u043c\u043e \u043f\u0440\u043e \u0432\u0430\u0441. \u0426\u0435 \u043d\u0435 \u0432\u043a\u043b\u044e\u0447\u0430\u0454 \u0431\u0443\u0434\u044c-\u044f\u043a\u0456 \u0434\u0430\u043d\u0456, \u044f\u043a\u0456 \u043c\u0438 \u0437\u043e\u0431\u043e\u0432&#8217;\u044f\u0437\u0430\u043d\u0456 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0442\u0438 \u0434\u043b\u044f \u0430\u0434\u043c\u0456\u043d\u0456\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043d\u0438\u0445, \u043f\u0440\u0430\u0432\u043e\u0432\u0438\u0445 \u0430\u0431\u043e \u0431\u0435\u0437\u043f\u0435\u043a\u043e\u0432\u0438\u0445 \u0446\u0456\u043b\u0435\u0439.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\">\u041a\u0443\u0434\u0438 \u0432\u0456\u0434\u043f\u0440\u0430\u0432\u043b\u044f\u044e\u0442\u044c\u0441\u044f \u0432\u0430\u0448\u0456 \u0434\u0430\u043d\u0456<\/h2>\n\n\n\n<p>\u041a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456 \u0432\u0456\u0434\u0432\u0456\u0434\u0443\u0432\u0430\u0447\u0456\u0432 \u043c\u043e\u0436\u0443\u0442\u044c \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u044f\u0442\u0438\u0441\u044f \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0437\u043e\u0432\u0430\u043d\u043e\u0457 \u0441\u043b\u0443\u0436\u0431\u0438 \u0432\u0438\u044f\u0432\u043b\u0435\u043d\u043d\u044f \u0441\u043f\u0430\u043c\u0443.<\/p>\n","protected":false},"excerpt":{"rendered":"<p>\u0425\u0442\u043e \u043c\u0438 \u041d\u0430\u0448\u0430 \u0430\u0434\u0440\u0435\u0441\u0430 \u0432\u0435\u0431-\u0441\u0430\u0439\u0442\u0443: https:\/\/dutchharborschool.nl. \u041a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456 \u041a\u043e\u043b\u0438 \u0432\u0456\u0434\u0432\u0456\u0434\u0443\u0432\u0430\u0447\u0456 \u0437\u0430\u043b\u0438\u0448\u0430\u044e\u0442\u044c \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456 \u043d\u0430 \u0441\u0430\u0439\u0442\u0456, \u043c\u0438 \u0437\u0431\u0438\u0440\u0430\u0454\u043c\u043e \u0434\u0430\u043d\u0456, \u0432\u043a\u0430\u0437\u0430\u043d\u0456 \u0443 \u0444\u043e\u0440\u043c\u0456 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u0432, \u0430 \u0442\u0430\u043a\u043e\u0436 IP-\u0430\u0434\u0440\u0435\u0441\u0443 \u0432\u0456\u0434\u0432\u0456\u0434\u0443\u0432\u0430\u0447\u0430 \u0442\u0430 \u0440\u044f\u0434\u043e\u043a \u0430\u0433\u0435\u043d\u0442\u0430 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430 \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0430, \u0449\u043e\u0431 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u0442\u0438 \u0443 \u0432\u0438\u044f\u0432\u043b\u0435\u043d\u043d\u0456 \u0441\u043f\u0430\u043c\u0443. \u0410\u043d\u043e\u043d\u0456\u043c\u0456\u0437\u043e\u0432\u0430\u043d\u0438\u0439 \u0440\u044f\u0434\u043e\u043a, \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u0438\u0439 \u0437 \u0432\u0430\u0448\u043e\u0457 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u0457 \u0430\u0434\u0440\u0435\u0441\u0438 (\u0442\u0430\u043a\u043e\u0436 \u0432\u0456\u0434\u043e\u043c\u0438\u0439 \u044f\u043a \u0445\u0435\u0448), \u043c\u043e\u0436\u0435 \u0431\u0443\u0442\u0438 \u043d\u0430\u0434\u0430\u043d\u0438\u0439 \u0441\u043b\u0443\u0436\u0431\u0456 Gravatar, \u0449\u043e\u0431 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438, \u0447\u0438 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454\u0442\u0435 \u0432\u0438 [&hellip;]<\/p>\n","protected":false},"author":1,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"open","template":"","meta":{"footnotes":""},"class_list":["post-3","page","type-page","status-publish","hentry"],"_links":{"self":[{"href":"https:\/\/dutchharborschool.nl\/wp-json\/wp\/v2\/pages\/3","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/dutchharborschool.nl\/wp-json\/wp\/v2\/pages"}],"about":[{"href":"https:\/\/dutchharborschool.nl\/wp-json\/wp\/v2\/types\/page"}],"author":[{"embeddable":true,"href":"https:\/\/dutchharborschool.nl\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/dutchharborschool.nl\/wp-json\/wp\/v2\/comments?post=3"}],"version-history":[{"count":2,"href":"https:\/\/dutchharborschool.nl\/wp-json\/wp\/v2\/pages\/3\/revisions"}],"predecessor-version":[{"id":83,"href":"https:\/\/dutchharborschool.nl\/wp-json\/wp\/v2\/pages\/3\/revisions\/83"}],"wp:attachment":[{"href":"https:\/\/dutchharborschool.nl\/wp-json\/wp\/v2\/media?parent=3"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}